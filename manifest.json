{
  "manifest_version": 3,
  "name": "Job Helper",
  "description": "Opens a proposal panel on OnlineJobs.ph job pages and scrapes the job overview.",
  "version": "0.2.0",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Job Helper — toggle panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.onlinejobs.ph/jobseekers/job*",
        "https://www.onlinejobs.ph/apply*",
        "https://www.linkedin.com/sharing/compose*",
        "https://www.linkedin.com/*"
      ],
      "js": ["js/panel-styles.js", "js/content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "clipboardWrite"],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api.groq.com/*",
    "https://openrouter.ai/*",
    "https://api.cerebras.ai/*",
    "https://api.mistral.ai/*",
    "https://models.github.ai/*"
  ]
}